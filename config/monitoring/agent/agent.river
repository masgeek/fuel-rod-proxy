variable "LOKI_URL" {
  default = "http://loki:3100"
}

variable "JOB_NAME" {
  default = "fuelrod"
}

variable "INSTANCE" {
  default = "grafana-agent"
}

variable "HOST" {
  default = "unknown"
}

discovery.local.file "supervisor_logs" {
  path_targets = [{
    __path__ = "/var/log/supervisor/*.log"
    job      = variable.JOB_NAME.value
    instance = variable.INSTANCE.value
    host      = variable.HOST.value
    app       = "fuelrod"
    component = "supervisor"
  }]
}

loki.source.file "supervisor" {
  targets    = discovery.local.file.supervisor_logs.targets
  forward_to = [loki.write.default.receiver]

  exclude_paths = [
    "*.log.gz",
    "*.log.zip",
    "*.log.[0-9]*",
  ]
}

loki.write "default" {
  endpoint {
    url         = variable.LOKI_URL.value + "/loki/api/v1/push"
    batch_wait  = "1s"
    batch_size  = 1048576
    min_backoff = "500ms"
    max_backoff = "5m"
    max_retries = 20
  }

  external_labels = {
    source      = "grafana-agent"
    environment = "production"
    stack       = "fuelrod"
  }
}

prometheus.scrape "agent_metrics" {
  targets = [{
    __address__ = "localhost:12345"
    job         = "grafana-agent"
  }]

  forward_to = [prometheus.remote_write.metrics.receiver]
}

prometheus.remote_write "metrics" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}