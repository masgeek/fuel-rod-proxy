// ---------------------------------------------------------------------------
// Grafana Alloy — central log collection agent
// Tails supervisor logs from all application stacks and pushes to Loki.
// ---------------------------------------------------------------------------

loki.relabel "fuelrod" {
  forward_to = [loki.write.default.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "replace"
    target_label  = "service_name"
    replacement   = "fuelrod"
  }
}

loki.relabel "fees" {
  forward_to = [loki.write.default.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "replace"
    target_label  = "service_name"
    replacement   = "fees"
  }
}

loki.relabel "fees_dev" {
  forward_to = [loki.write.default.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "replace"
    target_label  = "service_name"
    replacement   = "fees-dev"
  }
}

loki.relabel "akilimo" {
  forward_to = [loki.write.default.receiver]

  rule {
    source_labels = ["__name__"]
    action        = "replace"
    target_label  = "service_name"
    replacement   = "akilimo"
  }
}

loki.source.file "fuelrod" {
  targets    = [{__path__ = "/var/log/fuelrod/*.log"}]
  forward_to = [loki.relabel.fuelrod.receiver]
  file_match {
    enabled = true
  }
}

loki.source.file "fees" {
  targets    = [{__path__ = "/var/log/fees/*.log", "env" = "prod"}]
  forward_to = [loki.relabel.fees.receiver]
  file_match {
    enabled = true
  }
}

loki.source.file "fees_dev" {
  targets    = [{__path__ = "/var/log/fees-dev/*.log", "env" = "dev"}]
  forward_to = [loki.relabel.fees_dev.receiver]
  file_match {
    enabled = true
  }
}

loki.source.file "akilimo" {
  targets    = [{__path__ = "/var/log/akilimo/*.log"}]
  forward_to = [loki.relabel.akilimo.receiver]
  file_match {
    enabled = true
  }
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL") + "/loki/api/v1/push"
  }
  external_labels = {
    environment = "production",
  }
}

// ---------------------------------------------------------------------------
// Metrics: self-scrape and remote write to Prometheus
// ---------------------------------------------------------------------------
prometheus.scrape "agent" {
  targets = [
    {"__address__" = "127.0.0.1:12345"},
  ]
  forward_to       = [prometheus.remote_write.metrics.receiver]
  scrape_interval  = "30s"
  scrape_timeout   = "10s"
}

prometheus.remote_write "metrics" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
