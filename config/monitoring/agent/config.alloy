// ---------------------------------------------------------------------------
// Grafana Alloy — central log collection agent
// Collects application container logs and pushes them to Loki.
// ---------------------------------------------------------------------------

discovery.docker "applications" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "applications" {
  targets = discovery.docker.applications.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(fuelrod|fee\\.prod|fee\\.dev|akilimo-api)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/fuelrod"
    target_label  = "service_name"
    replacement   = "fuelrod-sms"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/fee\\.prod"
    target_label  = "service_name"
    replacement   = "fees"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/fee\\.dev"
    target_label  = "service_name"
    replacement   = "fees-dev"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/akilimo-api"
    target_label  = "service_name"
    replacement   = "akilimo"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/fee\\.dev"
    target_label  = "environment"
    replacement   = "development"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(fuelrod|fee\\.prod|akilimo-api)"
    target_label  = "environment"
    replacement   = "production"
  }
}

loki.source.docker "applications" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.applications.output
  labels     = {log_type = "container"}
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL") + "/loki/api/v1/push"
  }
}

// ---------------------------------------------------------------------------
// Metrics: self-scrape and remote write to Prometheus
// ---------------------------------------------------------------------------
prometheus.scrape "agent" {
  targets = [
    {"__address__" = "127.0.0.1:12345"},
  ]
  forward_to       = [prometheus.remote_write.metrics.receiver]
  scrape_interval  = "30s"
  scrape_timeout   = "10s"
}

prometheus.remote_write "metrics" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}
