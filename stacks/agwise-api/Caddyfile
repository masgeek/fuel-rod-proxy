# =============================================================================
# Caddy configuration for agwise-api stack
# Copy the relevant block(s) into your host Caddyfile
# =============================================================================

# -----------------------------------------------------------------------------
# api.agwise.org — agwise-api
# The API lives on its own host, separate from the main agwise app config, so
# it is not bundled with any app redirects. A plain reverse_proxy is all that
# is needed — no redirects, no path rewrites.
# -----------------------------------------------------------------------------
api.agwise.org {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/agwise-api.log
                format console
                level debug
        }

        handle {
                reverse_proxy 127.0.0.1:8000 {
                        header_up X-Forwarded-Host {host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Forwarded-Port {server_port}
                }
        }
}
