# =============================================================================
# AGWISE-API STACK — R/Plumber API service
# Copy to .env and fill in values before starting this stack.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tag — the prebuilt iita/agwise-api image to run. Pin a version for
# reproducibility instead of using `latest`.
# -----------------------------------------------------------------------------
TAG=latest

# -----------------------------------------------------------------------------
# API server URL — how the API addresses itself. Defaults to the container's
# own port. If the service is later exposed via Caddy, set this to the public
# URL (e.g. https://agwise.example.com) so generated links resolve outside.
# -----------------------------------------------------------------------------
API_SERVER_URL=http://localhost:8000
