# =============================================================================
# METABASE STACK — Metabase BI / analytics
# Copy to .env and fill in values before starting this stack.
# Database credentials must match the databases stack.
# =============================================================================

# Domain
METABASE_DOMAIN=metabase.example.com

# PostgreSQL connection (must match databases stack)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fuelrod
POSTGRES_PASSWORD=change_me

# Metabase internal database (stores Metabase config/questions)
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase
