# =============================================================================
# MONITORING STACK — Grafana, Prometheus, Loki, Grafana Agent, Beszel
# Copy to .env and fill in values before starting this stack.
# =============================================================================

# Domains
GRAFANA_DOMAIN=grafana.example.com
DOZZLE_DOMAIN=logs.example.com
BESZEL_DOMAIN=monitor.example.com

# Grafana credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_DB_URL=postgres://grafana_user:change_me@postgres:5432/postgres?sslmode=disable

# Beszel agent — values from the Beszel hub UI (Add System dialog)
BESZEL_AGENT_KEY=
BESZEL_HUB_URL=http://beszel:8090
BESZEL_AGENT_TOKEN=
BESZEL_AGENT_PORT=45876

# Log agent / host identity
DOZZLE_HOSTNAME=your-hostname
HOSTNAME=your-hostname
