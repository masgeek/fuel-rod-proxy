# =============================================================================
# MONITORING STACK — Grafana, Prometheus, Loki, Grafana Agent, Beszel
# Copy to .env and fill in values before starting this stack.
# =============================================================================

# Domains
GRAFANA_DOMAIN=grafana.example.com
BESZEL_DOMAIN=monitor.example.com

# Grafana credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

# PostgreSQL connection (used by Grafana)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=grafana_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fuelrod
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=disable

# Redis connection (used by Grafana redis-datasource plugin)
REDIS_HOST=cache:6379
REDIS_CLIENT=standalone
REDIS_PASSWORD=

# Loki
LOKI_HTTP_PORT=3100
LOKI_GRPC_PORT=9096
LOKI_LOG_LEVEL=info
LOKI_CACHE_MAX_SIZE_MB=100
LOKI_REJECT_OLD_SAMPLES_AGE=168h
LOKI_MAX_ENTRIES_LIMIT=5000
LOKI_RETENTION_PERIOD=168h

# Beszel agent — values from the Beszel hub UI (Add System dialog)
BESZEL_KEY=
BESZEL_TOKEN=
BESZEL_HUB_URL=http://beszel:8090
BESZEL_AGENT_PORT=45876

# Host identity (used by Grafana Agent)
JOB_NAME=fuelrod
SERVER_NAME=production
