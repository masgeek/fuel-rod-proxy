# =============================================================================
# Caddy configuration for Monitoring stack
# Copy the relevant block(s) into your host Caddyfile
# =============================================================================

# -----------------------------------------------------------------------------
# grafana — logs.munywele.co.ke + logs.akilimo.org
# HTTP reverse proxy to the grafana container on 127.0.0.1:9600
# -----------------------------------------------------------------------------
logs.munywele.co.ke, logs.akilimo.org {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/grafana.log
                format console
                level debug
        }

        encode gzip

        reverse_proxy 127.0.0.1:9600 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}

                health_uri /api/health
                health_interval 30s
                health_timeout 10s
        }

        @disallowed {
                path /.git/*
                path *.sql
        }
        respond @disallowed "Access Denied" 403
}
