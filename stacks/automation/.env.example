# =============================================================================
# AUTOMATION STACK — n8n workflow automation
# Copy to .env and fill in values before starting this stack.
# Database credentials must match the databases stack.
# =============================================================================

# Domain
N8N_DOMAIN=n8n.example.com

# PostgreSQL connection (must match databases stack)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fuelrod
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fuelrod
DB_WORKFLOW_SCHEMA=workflow

# n8n settings
N8N_TIMEZONE=UTC
N8N_EXECUTIONS_DATA_MAX_AGE=30
N8N_EXECUTIONS_DATA_PRUNE_MAX_COUNT=10
