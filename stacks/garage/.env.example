# =============================================================================
# GARAGE STACK — S3-compatible object storage (single node)
# Copy to .env and fill in values before starting this stack.
# Variables marked REQUIRED have no default and will abort startup if unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tag — pin to known-good versions
# -----------------------------------------------------------------------------
GARAGE_TAG=v2.3.0

# -----------------------------------------------------------------------------
# Cluster secrets — ALL REQUIRED
# Garage reads these at startup; they override the placeholder values in
# garage.toml. Generate fresh values with:
#   GARAGE_RPC_SECRET    -> openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN   -> openssl rand -base64 32
#   GARAGE_METRICS_TOKEN -> openssl rand -base64 32
# -----------------------------------------------------------------------------
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=

# -----------------------------------------------------------------------------
# S3 region — apps must use "garage"
# The S3 API region is fixed to "garage" in garage.toml. Set AWS_REGION /
# S3_REGION to "garage" in every client, otherwise SigV4 signatures will not
# validate. Endpoint for apps: https://s3.munywele.co.ke (path-style).
# -----------------------------------------------------------------------------
