# =============================================================================
# CADDY-MANAGER STACK — web UI + REST API for managing Caddy sites
# Copy to .env and fill in values before starting this stack.
# Variables marked REQUIRED have no default and will abort startup if unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tag — images are pulled as masgeek/caddy-manager-*:<TAG> (prebuilt).
# Pin a version for reproducibility.
# -----------------------------------------------------------------------------
TAG=latest

# -----------------------------------------------------------------------------
# Database — shared Postgres stack (host `postgres` on dokploy-network)
# The `caddy` database must exist first:
#   docker exec postgres createdb --username "$POSTGRES_USER" \
#     --owner "$POSTGRES_USER" caddy
# DB_USER/DB_PASSWORD are the shared POSTGRES_USER/POSTGRES_PASSWORD.
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=caddy
DB_USER=caddy
DB_PASSWORD=

# -----------------------------------------------------------------------------
# App secrets — REQUIRED
# JWT_SECRET signs API tokens. Generate with: openssl rand -hex 32
# CADDY_ALLOWED_HOSTS is the comma-separated list of hosts this instance may
# manage (e.g. *.munywele.co.ke,*.agwise.org).
# -----------------------------------------------------------------------------
JWT_SECRET=
CADDY_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# Caddy admin — the api manages the host's Caddy admin API.
# On the host Caddyfile bind the admin to the docker bridge so containers can
# reach it (private, not publicly routable):
#   {
#       admin 172.17.0.1:2019
#   }
# Then register the Caddy server in CaddyManager with API URL
# http://host.docker.internal:2019 (host-gateway). CADDY_ADMIN_TOKEN is only
# needed if your Caddy build requires one.
# -----------------------------------------------------------------------------
CADDY_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# App — optional (defaults shown)
# -----------------------------------------------------------------------------
LOG_LEVEL=info
SITE_CHECK_CRON=*/5 * * * *
ALLOW_PRIVATE_OUTBOUND=false

# -----------------------------------------------------------------------------
# Initial admin — seeded by the migrate service (SEED_PASSWORD REQUIRED)
# -----------------------------------------------------------------------------
SEED_EMAIL=admin@caddy.local
SEED_USERNAME=admin
SEED_PASSWORD=
SEED_ROLE=admin
