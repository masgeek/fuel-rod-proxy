# -----------------------------------------------------------------------------
# caddy.munywele.co.ke — caddy-manager (web UI)
# Web-facing admin interface. The api (Caddy admin integration) is not exposed;
# it stays internal on host 9620.
# -----------------------------------------------------------------------------
caddy.munywele.co.ke {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/caddy-manager.log
                format console
                level debug
        }

        handle {
                reverse_proxy 127.0.0.1:9621 {
                        header_up X-Forwarded-Host {host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Forwarded-Port {server_port}
                }
        }
}
