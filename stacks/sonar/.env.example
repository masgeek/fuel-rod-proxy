# =============================================================================
# SONAR STACK — SonarQube code quality
# Copy to .env and fill in values before starting this stack.
# Database credentials must match the databases stack.
# =============================================================================

# Image tag
SONAR_TAG=community

# Domain
SONAR_DOMAIN=sonar.example.com

# PostgreSQL connection (must match databases stack)
POSTGRES_USER=fuelrod
POSTGRES_PASSWORD=change_me
SONAR_JDBC_URL=jdbc:postgresql://postgres:5432/sonar

# SonarQube tokens
SONAR_TOKEN=
NVD_API_KEY=
