# =============================================================================
# DATABASES STACK — credentials for postgres, maria, redis
# Copy to .env and fill in values before starting this stack.
# =============================================================================

# PostgreSQL — superuser (owns all databases)
POSTGRES_USER=fuelrod
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fuelrod
POSTGRES_SCHEMA=fuelrod
ADDITIONAL_DBS=akilimo,shirakalu,sonar,metabase

# MariaDB
MARIADB_DATABASE=akilimo
MARIADB_USER=akilimo
MARIADB_PASSWORD=change_me
