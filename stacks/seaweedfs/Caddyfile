# =============================================================================
# Caddy configuration for SeaweedFS stack
# Copy the relevant block(s) into your host Caddyfile
# =============================================================================

# -----------------------------------------------------------------------------
# seaweedfs — s3.munywele.co.ke
# S3 API + presigned URL sharing. Must match S3_DOMAIN in the stack .env.
#
# Paths matching /<volumeId>,<fileId> are raw object-fid URLs that the S3
# gateway redirects clients to after signature validation. They are routed to
# the volume server (127.0.0.1:9613); everything else goes to the S3 gateway
# (127.0.0.1:9612).
#
# SECURITY: fid URLs are unguessable tokens that do not expire and bypass S3
# ACLs. Keep them private (only returned to authenticated clients via
# presigned URLs). Enable volume JWT signing for time-limited fid access.
# -----------------------------------------------------------------------------
s3.munywele.co.ke {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/s3.log
                format console
                level debug
        }

        @fid path_regexp fid ^/[0-9]+,[A-Za-z0-9_,.-]+$

        handle @fid {
                reverse_proxy 127.0.0.1:9613 {
                        header_up X-Forwarded-Host {host}
                        header_up X-Forwarded-Proto {scheme}
                }
        }

        handle {
                reverse_proxy 127.0.0.1:9612 {
                        header_up X-Forwarded-Host {host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Forwarded-Port {server_port}
                }
        }

        @disallowed {
                path /.git/*
                path *.sql
        }
        respond @disallowed "Access Denied" 403
}
