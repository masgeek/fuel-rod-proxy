# =============================================================================
# SEAWEEDFS STACK — S3-compatible object storage
# Copy to .env and fill in values before starting this stack.
# Variables marked REQUIRED have no default and will abort startup if unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tag — pin to known-good versions
# -----------------------------------------------------------------------------
SEAWEEDFS_TAG=4.40

# -----------------------------------------------------------------------------
# Public S3 domain — REQUIRED
# Must match the host Caddy route. Used for the volume redirect base URL
# (-publicUrl) and S3 gateway signature verification (-s3.externalUrl).
# -----------------------------------------------------------------------------
S3_DOMAIN=s3.example.com

# -----------------------------------------------------------------------------
# SeaweedFS — optional (defaults shown)
# -----------------------------------------------------------------------------
# Max size of a single volume in MB before rotating to a new one.
VOLUME_SIZE_LIMIT_MB=1024
# Maximum number of volumes the volume server may create (0 = auto/unlimited).
VOLUME_MAX=0

# -----------------------------------------------------------------------------
# S3 credentials
# Copy s3.json.example to s3.json and replace the access/secret keys BEFORE
# starting the stack. Access is locked down with "defaultEffect": "Deny", so
# only identities listed in s3.json can read or write objects.
# -----------------------------------------------------------------------------
