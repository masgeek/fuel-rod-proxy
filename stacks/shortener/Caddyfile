# =============================================================================
# Caddy configuration for shortener stack
# Copy the relevant block(s) into your host Caddyfile
# =============================================================================

# -----------------------------------------------------------------------------
# lnk.munywele.co.ke — shortener
# Short URLs and REST API (https://lnk.munywele.co.ke/abc, /rest/v2/...).
# -----------------------------------------------------------------------------
lnk.munywele.co.ke {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/lnk.log
                format console
                level debug
        }

        handle {
                reverse_proxy 127.0.0.1:9660 {
                        header_up X-Forwarded-Host {host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Forwarded-Port {server_port}
                }
        }
}

# -----------------------------------------------------------------------------
# lnk-admin.munywele.co.ke — web client
# Management UI. HTTPS basic auth in front of it; the UI still additionally
# asks for the Shlink API key on login.
#
# Generate the hash with: caddy hash-password  (bcrypt)
# For a stronger lockdown, also restrict to known IPs by uncommenting the
# client_ip matcher, or serve this host only on a VPN/Tailscale and drop the
# public Caddy route entirely.
# -----------------------------------------------------------------------------
lnk-admin.munywele.co.ke {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/lnk-admin.log
                format console
                level debug
        }

        basic_auth {
                # Replace with your own bcrypt hash: caddy hash-password
                admin $2a$14$REPLACE_WITH_YOUR_BCRYPT_HASH
        }

        handle {
                reverse_proxy 127.0.0.1:9662 {
                        header_up X-Forwarded-Host {host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Forwarded-Port {server_port}
                }
        }
}
