# =============================================================================
# SHORTENER STACK — URL shortener + management UI
# Copy to .env and fill in values before starting this stack.
# Variables marked REQUIRED have no default and will abort startup if unset.
#
# Generic names (SHORTENER_*) are provider-agnostic so the engine can be
# swapped without renaming anything here. Current engine: Kutt.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tag — default to latest; pin a version for reproducibility
# (e.g. SHORTENER_TAG=v3.2.6). `latest` currently tracks the v3.2.x line.
# -----------------------------------------------------------------------------
SHORTENER_TAG=latest

# -----------------------------------------------------------------------------
# Site
# SITE_NAME is the display name. DEFAULT_DOMAIN is what short links look like
# (https://<domain>/<code>) and what the app binds itself to.
# -----------------------------------------------------------------------------
SITE_NAME=Kutt
DEFAULT_DOMAIN=lnk.munywele.co.ke

# -----------------------------------------------------------------------------
# JWT secret — REQUIRED
# Passphrase used to sign auth tokens. Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=

# -----------------------------------------------------------------------------
# Database — shared Postgres stack (host `postgres` on dokploy-network)
# The `shortener` database must exist first:
#   docker exec postgres createdb --username "$POSTGRES_USER" \
#     --owner "$POSTGRES_USER" shortener
# Kutt runs its migrations automatically on every boot.
# DB_USER/DB_PASSWORD are the shared POSTGRES_USER/POSTGRES_PASSWORD.
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shortener
DB_USER=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Redis — shared cache stack (host `cache` on dokploy-network)
# Used for caching and rate limiting. REDIS_PASSWORD must match the cache
# stack's REDIS_PASSWORD (leave empty if the cache stack has none).
# -----------------------------------------------------------------------------
REDIS_ENABLED=true
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# Access policy — private by default
# DISALLOW_REGISTRATION=true     no public signup; only the initial admin
#                                (created on first visit) and any users you
#                                add from the admin page
# DISALLOW_ANONYMOUS_LINKS=true  only logged-in users can create links
# DISALLOW_LOGIN_FORM=false      keep the email/password login form; set true
#                                only when OIDC is enabled
# -----------------------------------------------------------------------------
DISALLOW_REGISTRATION=true
DISALLOW_ANONYMOUS_LINKS=true
DISALLOW_LOGIN_FORM=false

# -----------------------------------------------------------------------------
# Rate limiting and proxy trust
# TRUST_PROXY=true is required because this service sits behind Caddy — it
# makes Kutt read the real client IP from the X-Forwarded-For header.
# -----------------------------------------------------------------------------
ENABLE_RATE_LIMIT=true
TRUST_PROXY=true

# -----------------------------------------------------------------------------
# Mail (optional) — for registration invites, password resets, email changes
# Disabled by default: the admin account is created on first visit without
# email, and public registration is off. To enable, point at the shared
# mailpit relay (host `mailpit`, port 1025, accepts any credentials):
#   MAIL_ENABLED=true
#   MAIL_HOST=mailpit
#   MAIL_PORT=1025
#   MAIL_SECURE=false
#   MAIL_FROM="Kutt <shortener@munywele.co.ke>"
# -----------------------------------------------------------------------------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

REPORT_EMAIL=
CONTACT_EMAIL=

# -----------------------------------------------------------------------------
# Optional — OIDC/SSO (fits the existing Keycloak)
# -----------------------------------------------------------------------------
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_PROMPT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=
OIDC_EMAIL_CLAIM=
OIDC_BUTTON_TEXT=Log in with OIDC
