# =============================================================================
# SHLINK STACK — URL shortener (Shlink + web client)
# Copy to .env and fill in values before starting this stack.
# Variables marked REQUIRED have no default and will abort startup if unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tags — default to stable; pin a specific version for reproducibility
# (e.g. SHLINK_TAG=4.5). Web client shares the stable channel.
# -----------------------------------------------------------------------------
SHLINK_TAG=stable
WEB_TAG=stable

# -----------------------------------------------------------------------------
# Short domain
# DEFAULT_DOMAIN is what short links look like (https://<domain>/<code>).
# -----------------------------------------------------------------------------
DEFAULT_DOMAIN=lnk.munywele.co.ke
IS_HTTPS_ENABLED=true

# -----------------------------------------------------------------------------
# First API key — REQUIRED
# Shlink registers this key on first boot. It is used by the web client and by
# any API clients. Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
INITIAL_API_KEY=

# -----------------------------------------------------------------------------
# Database — shared Postgres stack (host `postgres` on dokploy-network)
# The `shlink` database must exist first:
#   docker exec postgres createdb --username "$POSTGRES_USER" \
#     --owner "$POSTGRES_USER" shlink
# DB_USER/DB_PASSWORD are the shared POSTGRES_USER/POSTGRES_PASSWORD.
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=shlink
DB_USER=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# GeoLite2 license key (optional)
# Enables geolocation of visits in analytics. Get one free at:
# https://www.maxmind.com/en/geolite2/signup — empty disables location data.
# -----------------------------------------------------------------------------
GEOLITE_LICENSE_KEY=

# -----------------------------------------------------------------------------
# Web client (lnk-admin.munywele.co.ke)
# Pre-configures the server on the login screen. Leaving the API key unset
# (recommended) means entering it in the UI on first login.
# -----------------------------------------------------------------------------
SHLINK_SERVER_URL=https://lnk.munywele.co.ke
SHLINK_SERVER_NAME=Shlink
