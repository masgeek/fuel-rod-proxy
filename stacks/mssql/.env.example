# =============================================================================
# MSSQL STACK — local development only
# Copy to .env and fill in values before starting this stack.
# =============================================================================

# SA password (required — must be at least 8 chars, include uppercase,
# lowercase, digits, and special characters)
MSSQL_SA_PASSWORD=change_me

# Product edition: Developer (default), Express, Standard, Enterprise
MSSQL_PID=Developer
