# =============================================================================
# FARM STACK — Farm Manager API, web, and migrations
# Copy to .env and fill in values before starting this stack.
# Database credentials must match the databases stack.
# The fuelrod stack must be running first (provides the 'uploads' volume).
# =============================================================================

# Image tag — pin to known-good version; Renovate will update this
FARM_TAG=latest

# Domains
FARM_API_DOMAIN=farm-api.example.com
FARM_WEB_DOMAIN=farm.example.com

# PostgreSQL connection (must match databases stack)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fuelrod
POSTGRES_PASSWORD=change_me

# Farm database
FARM_DB_DATABASE=shirakalu
FARM_DB_SCHEMA=public

# API / web
API_URL=https://farm-api.example.com
CLIENT_ORIGIN=https://farm.example.com
CLIENT_PROTOCOL=https
CLIENT_HOST=farm-api.example.com
CLIENT_PORT=443

# Auth
JWT_SECRET=generate_with_openssl_rand_base64_32
JWT_EXPIRES_SECONDS=604800
DEFAULT_PASSWORD=change_me

# File uploads
UPLOAD_DIR=

# Mail — Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.example.com
MAILGUN_ENDPOINT=https://api.eu.mailgun.net

# Mail — SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shirakalu.farm

# Africa's Talking SMS
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# HTTP SMS gateway
SMS_HTTP_URL=
SMS_HTTP_API_KEY=
