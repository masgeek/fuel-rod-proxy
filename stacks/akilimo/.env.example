# =============================================================================
# AKILIMO STACK — application environment
# Copy to .env and fill in values before starting this stack.
# Variables marked REQUIRED have no default and will abort startup if unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tags — pin to known-good versions; Renovate will update these
# -----------------------------------------------------------------------------
AKILIMO_TAG=latest
USE_UPTAKE_TAG=1.0.0

# -----------------------------------------------------------------------------
# Domains
# -----------------------------------------------------------------------------
AKILIMO_DOMAIN=akilimo.example.com
USE_UPTAKE_DOMAIN=uptake.example.com

# -----------------------------------------------------------------------------
# Application — REQUIRED
# Generate APP_KEY with: php artisan key:generate --show
# -----------------------------------------------------------------------------
APP_KEY=base64:generate_with_php_artisan_key_generate
APP_URL=https://akilimo.example.com
AKILIMO_COMPUTE_BASE_URL=http://172.17.0.1:8001

# Application — optional (defaults shown)
APP_NAME=Akilimo API
APP_ENV=production
APP_DEBUG=false

# -----------------------------------------------------------------------------
# Database — REQUIRED (must match databases stack .env)
# -----------------------------------------------------------------------------
DB_HOST=172.17.0.1
DB_DATABASE=akilimo
DB_USERNAME=akilimo
DB_PASSWORD=change_me
DEFAULT_ADMIN_PASSWORD=change_me

# Database — optional (defaults shown)
DB_CONNECTION=mariadb
DB_PORT=3306
DB_TYPE=mysql

# -----------------------------------------------------------------------------
# Redis — optional (defaults shown)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Cache & session — optional (defaults shown)
# -----------------------------------------------------------------------------
CACHE_STORE=redis
CACHE_TTL=30s
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# -----------------------------------------------------------------------------
# Queue — optional (defaults shown)
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=redis
QUEUE_WORKERS=5
QUEUE_MAX_TRIES=3
QUEUE_TIMEOUT=3600
QUEUE_SLEEP=3
ENV_QUEUE_TIMEOUT=60
AUTO_RECOVER_FAILED_MIGRATIONS=false

# -----------------------------------------------------------------------------
# Logging — optional (defaults shown)
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Filesystem — optional (defaults shown)
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# Mail — optional (defaults shown; set MAIL_HOST if not using Mailpit)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@akilimo.org
MAIL_FROM_NAME=Akilimo

# -----------------------------------------------------------------------------
# PHP-FPM process manager — optional (defaults shown, tune per host)
# -----------------------------------------------------------------------------
PHP_FPM_PM_MAX_CHILDREN=50
PHP_FPM_PM_START_SERVERS=5
PHP_FPM_PM_MIN_SPARE_SERVERS=5
PHP_FPM_PM_MAX_SPARE_SERVERS=10
