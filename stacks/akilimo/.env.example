# =============================================================================
# AKILIMO STACK — application environment
# Copy to .env and fill in values before starting this stack.
# All variables needed by akilimo and use-uptake.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tags — pin to known-good versions; Renovate will update these
# -----------------------------------------------------------------------------
AKILIMO_TAG=latest
AKILIMO_VERSION_TAG=latest
COMPUTE_VERSION=latest
COMPUTE_REPLICAS=1
TAG=latest

# -----------------------------------------------------------------------------
# MariaDB (must match databases stack)
# -----------------------------------------------------------------------------
MARIADB_USER=akilimo
MARIADB_PASSWORD=change_me

# -----------------------------------------------------------------------------
# Domains
# -----------------------------------------------------------------------------
AKILIMO_DOMAIN=akilimo.example.com
USE_UPTAKE_DOMAIN=uptake.example.com

# -----------------------------------------------------------------------------
# Akilimo service
# -----------------------------------------------------------------------------
AKILIMO_DB_URL=jdbc:mariadb://maria:3306/akilimo
AKILIMO_USER=akilimo
AKILIMO_DB_PASS=change_me
COMPUTE_NG=http://compute:8080
COMPUTE_TZ=http://compute:8080
VOLUME_PATH=./akilimo-recommendations

# -----------------------------------------------------------------------------
# Application (Laravel)
# Generate APP_KEY with: php artisan key:generate --show
# -----------------------------------------------------------------------------
APP_NAME=Akilimo
APP_ENV=production
APP_KEY=base64:generate_with_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://akilimo.example.com

# PHP-FPM process manager (tune per host)
FPM_MAX_CHILDREN=50
FPM_START_SERVERS=5
FPM_MIN_SPARE=5
FPM_MAX_SPARE=10

# Queue workers
Q_WORKERS=5
Q_MAX_TRIES=3
Q_TIMEOUT=3600
Q_SLEEP=3
