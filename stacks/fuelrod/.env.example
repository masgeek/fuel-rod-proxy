# =============================================================================
# FUELROD STACK — application environment
# Copy to .env and fill in values before starting this stack.
# All variables needed by fuelrod, farm, fees, sonar, metabase, and dozzle.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tags — pin to known-good versions; Renovate will update these
# -----------------------------------------------------------------------------
FUELROD_TAG=beta
PORTAL_TAG=latest
GATEWAY_TAG=latest
FARM_TAG=latest
SYNCER_TAG=latest
TAG=latest

# -----------------------------------------------------------------------------
# PostgreSQL (must match databases stack)
# -----------------------------------------------------------------------------
DB_DATABASE=fuelrod
DB_USERNAME=fuelrod
DB_PASSWORD=change_me
DB_SCHEMA=fuelrod

# -----------------------------------------------------------------------------
# Redis (must match databases stack)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Domains
# -----------------------------------------------------------------------------
FUELROD_DOMAIN=fuelrod.example.com
PORTAL_DOMAIN=portal.example.com
GATEWAY_DOMAIN=sms.example.com
FARM_API_DOMAIN=farm-api.example.com
FARM_WEB_DOMAIN=farm.example.com
FEES_PROD_DOMAIN=fees.example.com
FEES_DEV_DOMAIN=fees-dev.example.com
SONAR_DOMAIN=sonar.example.com
METABASE_DOMAIN=metabase.example.com
REDIS_ADMIN_DOMAIN=redis.example.com
MAILPIT_DOMAIN=mail.example.com
DOZZLE_DOMAIN=logs.example.com
DOZZLE_HOSTNAME=your-hostname

# -----------------------------------------------------------------------------
# Farm service
# -----------------------------------------------------------------------------
JWT_SECRET=generate_with_openssl_rand_base64_32
DEFAULT_PASSWORD=change_me
FARM_DB_DATABASE=shirakalu
API_URL=https://farm-api.example.com
CLIENT_ORIGIN=https://farm.example.com
WEB_PORT=3008
API_PORT=3001
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_USER=${DB_USERNAME}

# -----------------------------------------------------------------------------
# Queue workers
# -----------------------------------------------------------------------------
QUEUE_WORKERS=0
QUEUE_HEAVY_WORKERS=1
QUEUE_MAX_TRIES=1
Q_WORKERS=1
Q_HEAVY_WORKERS=0
Q_MAX_TRIES=1
SCHEDULER_INTERVAL=5s

# -----------------------------------------------------------------------------
# PHP-FPM process manager (tune per host)
# -----------------------------------------------------------------------------
FPM_MAX_CHILDREN=50
FPM_START_SERVERS=5
FPM_MIN_SPARE=5
FPM_MAX_SPARE=10

# -----------------------------------------------------------------------------
# Application (Laravel)
# Generate APP_KEY with: php artisan key:generate --show
# -----------------------------------------------------------------------------
APP_NAME=Fuelrod
APP_ENV=production
APP_KEY=base64:generate_with_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://fuelrod.example.com

# Logging
LOG_CHANNEL=stack
LOG_CHANNELS=loki,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_SLACK_WEBHOOK_URL=

# Database connection
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432

# Cache / Queue (Redis)
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_QUEUE=fuelrod
BROKER_HOST=${REDIS_HOST}
BROKER_PORT=${REDIS_PORT}
BROKER_PASS=${REDIS_PASSWORD}

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
SMTP_FROM=noreply@example.com
MAILGUN_DOMAIN=mg.example.com
MAILGUN_API_KEY=

# Zoho CRM (leave blank to disable)
ZOHO_REDIRECT_URL=https://fuelrod.example.com/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_WEBHOOK_SECRET=

# SonarQube (leave blank to disable)
SONAR_TOKEN=
NVD_API_KEY=
