# =============================================================================
# FUELROD STACK — application environment
# Copy to .env and fill in values before starting this stack.
# All variables needed by fuelrod (portal, gateway).
# =============================================================================

# -----------------------------------------------------------------------------
# Image tags — pin to known-good versions; Renovate will update these
# -----------------------------------------------------------------------------
FUELROD_TAG=beta
PORTAL_TAG=latest
GATEWAY_TAG=latest
TAG=latest

# -----------------------------------------------------------------------------
# PostgreSQL (must match databases stack)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fuelrod
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fuelrod
POSTGRES_SCHEMA=fuelrod

# -----------------------------------------------------------------------------
# Redis (must match databases stack)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Domains
# -----------------------------------------------------------------------------
FUELROD_DOMAIN=fuelrod.example.com
PORTAL_DOMAIN=portal.example.com
GATEWAY_DOMAIN=sms.example.com

# -----------------------------------------------------------------------------
# Queue workers (fuelrod service) — optional (defaults shown)
# -----------------------------------------------------------------------------
QUEUE_TIMEOUT=90             # job timeout (seconds) for all queues except campaign
QUEUE_CAMPAIGN_TIMEOUT=300   # job timeout (seconds) for campaign queue — needs longer for large slices
QUEUE_SLEEP=3                # seconds to sleep when queue is empty
QUEUE_WORKERS=2              # numprocs for standard queues (api-logs, sms-update, campaign, etc.)
QUEUE_HEAVY_WORKERS=3        # numprocs for high-throughput queues (call-back, sms-update-chunked, zoho, resend, archive, map-network)
QUEUE_MAX_TRIES=3            # max job attempts before marking failed

# -----------------------------------------------------------------------------
# PHP-FPM process manager — optional (defaults shown, tune per host)
# -----------------------------------------------------------------------------
PHP_FPM_PM_MAX_CHILDREN=50
PHP_FPM_PM_START_SERVERS=5
PHP_FPM_PM_MIN_SPARE_SERVERS=5
PHP_FPM_PM_MAX_SPARE_SERVERS=10

# -----------------------------------------------------------------------------
# Application (Laravel)
# Generate APP_KEY with: php artisan key:generate --show
# -----------------------------------------------------------------------------
APP_NAME=Fuelrod
APP_ENV=production
APP_KEY=base64:generate_with_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://fuelrod.example.com

# Logging
LOG_CHANNEL=stack
LOG_CHANNELS=loki,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_SLACK_WEBHOOK_URL=

# Database connection (Laravel)
DB_CONNECTION=pgsql
DB_HOST=${POSTGRES_HOST}
DB_PORT=${POSTGRES_PORT}
DB_DATABASE=${POSTGRES_DB}
DB_USERNAME=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# Cache / Queue (Redis)
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_QUEUE=fuelrod
BROKER_HOST=${REDIS_HOST}
BROKER_PORT=${REDIS_PORT}
BROKER_PASS=${REDIS_PASSWORD}

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
SMTP_FROM=noreply@example.com
MAILGUN_DOMAIN=mg.example.com
MAILGUN_API_KEY=

# Zoho CRM (leave blank to disable)
ZOHO_REDIRECT_URL=https://fuelrod.example.com/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_WEBHOOK_SECRET=
