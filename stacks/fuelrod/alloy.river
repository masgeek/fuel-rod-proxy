loki.source.file "logs" {
  targets    = [{__path__ = "/var/log/supervisor/*.log"}]
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL") + "/loki/api/v1/push"
  }
  external_labels = {
    environment = "production",
    stack       = "fuelrod",
  }
}
