# =============================================================================
# Caddy configuration for S3 stack
# Copy the relevant block(s) into your host Caddyfile
# =============================================================================

# -----------------------------------------------------------------------------
# s3 — s3.munywele.co.ke
# S3 API + presigned URL sharing, plus the login-gated admin console on the
# same host.
#
# Clients point at https://s3.munywele.co.ke (path-style) and use the default
# region us-east-1 (MINIO_SITE_REGION in the stack .env). Requests carrying
# AWS SigV4 credentials (Authorization: AWS4-* header, or the X-Amz-* query
# params on presigned URLs) are the S3 API and go to the API backend; all
# other traffic is the console UI and goes to the console backend.
#
# The console must be reachable via this public host because MinIO builds
# console share links from the URL the browser used to reach the console
# (MINIO_SERVER_URL is deprecated). Over an SSH tunnel those links would carry
# a useless localhost host. Caveat: unsigned/anonymous requests to this host
# are treated as console traffic, so public (no-auth) buckets would not be
# served here.
# -----------------------------------------------------------------------------
s3.munywele.co.ke {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/s3.log
                format console
                level debug
        }

        @disallowed {
                path /.git/*
                path *.sql
        }
        respond @disallowed "Access Denied" 403

        @s3 {
                header Authorization AWS4-*
                query X-Amz-Algorithm=*
                path /minio/health*
        }
        handle @s3 {
                reverse_proxy 127.0.0.1:9612 {
                        header_up X-Forwarded-Host {host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Forwarded-Port {server_port}
                }
        }
        handle {
                reverse_proxy 127.0.0.1:9614 {
                        header_up X-Forwarded-Host {host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Forwarded-Port {server_port}
                }
        }
}
