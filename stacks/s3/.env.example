# =============================================================================
# S3 STACK — S3-compatible object storage (single node, MinIO engine)
# Copy to .env and fill in values before starting this stack.
# Variables marked REQUIRED have no default and will abort startup if unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tag — pin to known-good versions
# pgsty/minio is the community-maintained fork of MinIO. Upstream minio/minio
# is archived (read-only since Feb 2026) and no longer ships releases or the
# admin console; this fork restores both.
# -----------------------------------------------------------------------------
MINIO_TAG=RELEASE.2026-06-18T00-00-00Z

# -----------------------------------------------------------------------------
# Root credentials — REQUIRED
# Used for both the S3 API and the console login.
#   MINIO_ROOT_USER:     3-32 alphanumeric characters
#   MINIO_ROOT_PASSWORD: at least 8 characters
# Generate a password with: openssl rand -hex 16
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# S3 region
# Defaults to "us-east-1" (the AWS SDK default), so clients usually need no
# region configuration. Only change if your apps use a different region.
# Endpoint for apps: https://s3.munywele.co.ke (path-style).
# -----------------------------------------------------------------------------
MINIO_SITE_REGION=us-east-1
