# =============================================================================
# S3 STACK — S3-compatible object storage (Alarik engine)
# Copy to .env and fill in values before starting this stack.
# Variables marked REQUIRED have no default and will abort startup if unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Image tag — pin to known-good versions
# Alarik (ghcr.io/achtungsoftware/alarik) is a Swift, Apache-2.0 S3-compatible
# server. Alpha/beta software. Console image shares the same tag.
# -----------------------------------------------------------------------------
ALARIK_TAG=1.0.0-beta-13

# -----------------------------------------------------------------------------
# Public URLs
# API_BASE_URL is where share links point — it is generated into share URLs
# server-side, so it must be the public API host (never localhost).
# -----------------------------------------------------------------------------
API_BASE_URL=https://s3.munywele.co.ke
CONSOLE_BASE_URL=https://s3-console.munywele.co.ke

# -----------------------------------------------------------------------------
# Region
# S3 clients MUST sign requests for this exact region (a mismatch is rejected,
# like real S3). Keep us-east-1 unless apps use a different region.
# Endpoint for apps: https://s3.munywele.co.ke (path-style).
# -----------------------------------------------------------------------------
ALARIK_REGION=us-east-1

# -----------------------------------------------------------------------------
# Admin account — REQUIRED
# Used for console login. Default admin is created on first startup.
# -----------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Console session signing secret — REQUIRED
# A node started with a missing JWT refuses to boot in production.
# Generate with: openssl rand -base64 48
# -----------------------------------------------------------------------------
JWT=

# -----------------------------------------------------------------------------
# Default S3 access keys for the admin account (optional)
# Apps can use these, or keys created per-user in the console.
# -----------------------------------------------------------------------------
DEFAULT_ACCESS_KEY=
DEFAULT_SECRET_KEY=

# -----------------------------------------------------------------------------
# Optional comma-separated buckets to auto-create at startup (admin-owned).
# -----------------------------------------------------------------------------
DEFAULT_BUCKETS=

# -----------------------------------------------------------------------------
# Account creation
# Keep false to disable self-registration and SSO auto-provisioning.
# -----------------------------------------------------------------------------
ALLOW_ACCOUNT_CREATION=false

# -----------------------------------------------------------------------------
# Durability
# fsync uploads before acknowledging (recommended for real data).
# -----------------------------------------------------------------------------
ALARIK_FSYNC=true
