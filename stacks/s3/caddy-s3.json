{
  "@id": "s3",
  "match": [
    {
      "host": [
        "s3.munywele.co.ke"
      ]
    }
  ],
  "handle": [
    {
      "handler": "subroute",
      "routes": [
        {
          "match": [
            {
              "path": [
                "/.git/*",
                "*.sql"
              ]
            }
          ],
          "handle": [
            {
              "handler": "static_response",
              "status_code": 403,
              "body": "Access Denied"
            }
          ]
        },
        {
          "handle": [
            {
              "handler": "reverse_proxy",
              "upstreams": [
                {
                  "dial": "127.0.0.1:9612"
                }
              ],
              "headers": {
                "request": {
                  "set": {
                    "X-Forwarded-Host": [
                      "{http.request.host}"
                    ],
                    "X-Forwarded-Proto": [
                      "{http.request.scheme}"
                    ],
                    "X-Forwarded-Port": [
                      "{http.request.port}"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
