{
  "@id": "s3-console",
  "match": [
    {
      "host": [
        "s3-console.munywele.co.ke"
      ]
    }
  ],
  "handle": [
    {
      "handler": "reverse_proxy",
      "upstreams": [
        {
          "dial": "127.0.0.1:9614"
        }
      ],
      "headers": {
        "request": {
          "set": {
            "X-Forwarded-Host": [
              "{http.request.host}"
            ],
            "X-Forwarded-Proto": [
              "{http.request.scheme}"
            ],
            "X-Forwarded-Port": [
              "{http.request.port}"
            ]
          }
        }
      }
    }
  ]
}
