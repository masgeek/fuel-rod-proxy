# =============================================================================
# Caddy configuration for Fuelrod stack
# Copy the relevant block(s) into your host Caddyfile
# =============================================================================

# -----------------------------------------------------------------------------
# fuelrod portal — sms.munywele.co.ke
# HTTP reverse proxy to the portal container on 127.0.0.1:9201
# -----------------------------------------------------------------------------
sms.munywele.co.ke {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/fuelrod-portal.log
                format console
                level debug
        }

        encode gzip

        reverse_proxy 127.0.0.1:9201 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}


        }

        @disallowed {
                path /.git/*
                path *.sql
        }
        respond @disallowed "Access Denied" 403
}
