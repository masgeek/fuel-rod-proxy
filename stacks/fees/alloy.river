loki.source.file "prod" {
  targets    = [{__path__ = "/var/log/supervisor/prod/*.log", "env" = "prod"}]
  forward_to = [loki.write.default.receiver]
}

loki.source.file "dev" {
  targets    = [{__path__ = "/var/log/supervisor/dev/*.log", "env" = "dev"}]
  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL") + "/loki/api/v1/push"
  }
  external_labels = {
    environment = "production",
    stack       = "fees",
  }
}
