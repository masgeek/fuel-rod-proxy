# =============================================================================
# FEES STACK — fee-syncer (prod + dev)
# Copy to .env and fill in values before starting this stack.
# =============================================================================

# Image tag — pin to known-good version; Renovate will update this
SYNCER_TAG=latest

# Domains
FEES_PROD_DOMAIN=fees.example.com
FEES_DEV_DOMAIN=fees-dev.example.com

# Queue workers
Q_WORKERS=1
Q_HEAVY_WORKERS=1
Q_MAX_TRIES=3
Q_TIMEOUT=3600
Q_SLEEP=3

# PHP-FPM process manager (tune per host)
FPM_MAX_CHILDREN=50
FPM_START_SERVERS=10
FPM_MIN_SPARE=7
FPM_MAX_SPARE=15

# Queue toggle per environment
PROD_QUEUE_ENABLED=true
DEV_QUEUE_ENABLED=false
