# =============================================================================
# FEES STACK — fee-syncer (prod + dev)
# Copy to .env and fill in values before starting this stack.
# =============================================================================

# Image tag — pin to known-good version; Renovate will update this
SYNCER_TAG=latest

# Logging
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning
DEV_LOG_LEVEL=debug

# Domains
FEES_PROD_DOMAIN=fees.example.com
FEES_DEV_DOMAIN=fees-dev.example.com

# Queue workers — optional (defaults shown)
QUEUE_WORKERS=1
QUEUE_HEAVY_WORKERS=1
QUEUE_MAX_TRIES=3
QUEUE_TIMEOUT=3600
QUEUE_SLEEP=3

# Queue toggle per environment — optional (defaults shown)
QUEUE_ENABLED_PROD=true
QUEUE_ENABLED_DEV=false
