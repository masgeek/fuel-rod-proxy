# =============================================================================
# Caddy configuration for Fees stack
# Copy the relevant block(s) into your host Caddyfile
# =============================================================================

# -----------------------------------------------------------------------------
# fee.prod — fees.munywele.co.ke
# HTTP reverse proxy to the fee.prod container on 127.0.0.1:9400
# -----------------------------------------------------------------------------
fees.munywele.co.ke {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/fees-prod.log
                format console
                level debug
        }

        encode gzip

        reverse_proxy 127.0.0.1:9400 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}

                health_uri /health
                health_interval 30s
                health_timeout 10s
        }

        @disallowed {
                path /.git/*
                path *.sql
        }
        respond @disallowed "Access Denied" 403
}

# -----------------------------------------------------------------------------
# fee.dev — fees-dev.munywele.co.ke
# HTTP reverse proxy to the fee.dev container on 127.0.0.1:9401
# -----------------------------------------------------------------------------
fees-dev.munywele.co.ke {
        tls dev@munywele.co.ke

        log {
                output file /var/log/caddy/fees-dev.log
                format console
                level debug
        }

        encode gzip

        reverse_proxy 127.0.0.1:9401 {
                header_up Host {host}
                header_up X-Real-IP {remote_host}
                header_up X-Forwarded-For {remote_host}
                header_up X-Forwarded-Proto {scheme}

                health_uri /health
                health_interval 30s
                health_timeout 10s
        }

        @disallowed {
                path /.git/*
                path *.sql
        }
        respond @disallowed "Access Denied" 403
}
