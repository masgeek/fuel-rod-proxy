# =============================================================================
# MQTT STACK — EMQX broker
# Copy to .env and replace the dashboard password before starting the stack.
# =============================================================================

# Broker image
MQTT_IMAGE=emqx/emqx
MQTT_VERSION=latest

# MQTT clients in other stacks use mqtt:1883 on dokploy-network.
# Keep this on loopback unless the host port must be reached externally.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883

# MQTT over WebSocket backend used by the host Caddy route.
MQTT_WS_BIND_ADDRESS=127.0.0.1
MQTT_WS_PORT=8083

# Stable Erlang cookie used for EMQX node identity and clustering.
MQTT_NODE_COOKIE=replace-with-a-long-random-cookie

# EMQX dashboard: http://127.0.0.1:18083
MQTT_DASHBOARD_BIND_ADDRESS=127.0.0.1
MQTT_DASHBOARD_PORT=18083
MQTT_DASHBOARD_USERNAME=admin
MQTT_DASHBOARD_PASSWORD=change-this-dashboard-password

# EMQX needs more memory than the previous 256 MB limit, especially with the dashboard.
MQTT_MEMORY_LIMIT=1g
MQTT_CPU_LIMIT=1.0
