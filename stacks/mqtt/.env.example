# =============================================================================
# MQTT STACK — EMQX broker
# Copy to .env and replace the dashboard password before starting the stack.
# =============================================================================

# MQTT clients in other stacks use emqx:1883 on dokploy-network.
# Keep this on loopback unless the host port must be reached externally.
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883

# Stable Erlang cookie used for EMQX node identity and clustering.
EMQX_NODE_COOKIE=replace-with-a-long-random-cookie

# EMQX dashboard: http://127.0.0.1:18083
EMQX_DASHBOARD_BIND_ADDRESS=127.0.0.1
EMQX_DASHBOARD_PORT=18083
EMQX_DASHBOARD_USERNAME=admin
EMQX_DASHBOARD_PASSWORD=change-this-dashboard-password
