# =============================================================================
# FEES (KAMBUI) STACK — Laravel application environment
# Copy to .env-fees and fill in values before starting the Fees stack.
# Loaded alongside .env; values here override .env for the same key.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# Generate APP_KEY with: php artisan key:generate --show
# -----------------------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=production
APP_KEY=base64:generate_with_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://your-fees-domain.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kambui
DB_USERNAME=fuelrod
DB_PASSWORD=change_me
DB_SCHEMA=public

# -----------------------------------------------------------------------------
# Session / Cache / Queue
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Redis (optional — only if switching queue/cache driver to redis)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log
# Production example:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_FROM_ADDRESS=noreply@example.com

# -----------------------------------------------------------------------------
# Kambui API (internal service-to-service)
# -----------------------------------------------------------------------------
KAMBUI_API_USERNAME=your_api_username
KAMBUI_API_PASSWORD=change_me
KAMBUI_API_BASE=https://your-kambui-api.example.com/api

# -----------------------------------------------------------------------------
# Vite (frontend build)
# -----------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
