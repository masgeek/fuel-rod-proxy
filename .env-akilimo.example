# =============================================================================
# AKILIMO STACK — application environment
# Copy to .env-akilimo and fill in values before starting the Akilimo stack.
# Loaded by both the api and compute services.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# Generate APP_KEY with: php artisan key:generate --show
# -----------------------------------------------------------------------------
APP_NAME=Akilimo
APP_ENV=production
APP_KEY=base64:generate_with_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://your-akilimo-domain.example.com

# -----------------------------------------------------------------------------
# Database (legacy Akilimo service — docker-compose.akilimo.yml)
# AKILIMO_DB_URL format: jdbc:mariadb://maria:3306/akilimo
# -----------------------------------------------------------------------------
AKILIMO_DB_URL=jdbc:mariadb://maria:3306/akilimo
AKILIMO_USER=akilimo
AKILIMO_DB_PASS=change_me

# -----------------------------------------------------------------------------
# Compute service URLs (used by legacy Akilimo API)
# COMPUTE_NG: Nigeria endpoint
# COMPUTE_TZ: Tanzania endpoint
# -----------------------------------------------------------------------------
COMPUTE_NG=http://compute:8080
COMPUTE_TZ=http://compute:8080

# -----------------------------------------------------------------------------
# Image tags
# -----------------------------------------------------------------------------
AKILIMO_TAG=latest
AKILIMO_VERSION_TAG=latest
COMPUTE_VERSION=latest
COMPUTE_REPLICAS=1

# -----------------------------------------------------------------------------
# Compute volume path (recommendations data)
# Override to use a named path on the host instead of a relative directory.
# -----------------------------------------------------------------------------
VOLUME_PATH=./akilimo-recommendations

# -----------------------------------------------------------------------------
# PHP-FPM process manager (tune per host)
# -----------------------------------------------------------------------------
FPM_MAX_CHILDREN=50
FPM_START_SERVERS=5
FPM_MIN_SPARE=5
FPM_MAX_SPARE=10

# Queue workers
Q_WORKERS=5
Q_MAX_TRIES=3
Q_TIMEOUT=3600
Q_SLEEP=3
