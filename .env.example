# =============================================================================
# BASE ENVIRONMENT — used by all stacks
# Copy to .env and fill in values before starting any stack.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DB_DATABASE=fuelrod
DB_USERNAME=fuelrod
DB_PASSWORD=change_me
DB_SCHEMA=fuelrod

# -----------------------------------------------------------------------------
# MariaDB
# -----------------------------------------------------------------------------
MARIADB_USER=akilimo
MARIADB_PASSWORD=change_me

# -----------------------------------------------------------------------------
# MSSQL
# MSSQL_PID: Developer | Express | Standard | Enterprise
# -----------------------------------------------------------------------------
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=change_me_min_8_chars_with_uppercase_number_and_symbol
MSSQL_PID=Express

# -----------------------------------------------------------------------------
# Redis
# Leave REDIS_PASSWORD empty to disable auth.
# -----------------------------------------------------------------------------
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=fuelrod
MINIO_ROOT_PASSWORD=change_me
MINIO_ACCESS_KEY=fuelrod
MINIO_SECRET_KEY=change_me
MINIO_DEFAULT_BUCKETS=fuelrod
MINIO_SCHEME=http
MINIO_UPDATE=off
MINIO_PROMETHEUS_AUTH_TYPE=public
MINIO_SERVER_URL=http://minio:9000
MINIO_STORAGE_CLASS_STANDARD=EC:0

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
GRAFANA_DB_URL=postgres://grafana_user:change_me@postgres:5432/postgres?sslmode=disable
DOZZLE_HOSTNAME=your-hostname

# -----------------------------------------------------------------------------
# Application defaults (shared across stacks)
# -----------------------------------------------------------------------------
DEFAULT_PASSWORD=change_me
JWT_SECRET=generate_with_openssl_rand_base64_32

# PHP-FPM process manager (tune per host)
FPM_MAX_CHILDREN=50
FPM_START_SERVERS=5
FPM_MIN_SPARE=5
FPM_MAX_SPARE=10

# Queue workers
Q_WORKERS=1
Q_HEAVY_WORKERS=0
Q_MAX_TRIES=1
QUEUE_WORKERS=1
SCHEDULER_INTERVAL=5s

# -----------------------------------------------------------------------------
# Farm service ports
# -----------------------------------------------------------------------------
WEB_PORT=3008
API_PORT=3001
API_URL=http://127.0.0.1:3001
CLIENT_ORIGIN=http://127.0.0.1:3008
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_USER=${DB_USERNAME}

# -----------------------------------------------------------------------------
# Migration (MySQL → PostgreSQL)
# -----------------------------------------------------------------------------
MYSQL_URL=mysql://root:change_me@127.0.0.1:3306/akilimo
POSTGRES_URL=postgresql://fuelrod:change_me@127.0.0.1:5432/akilimo

# -----------------------------------------------------------------------------
# Mail (Mailgun)
# -----------------------------------------------------------------------------
SMTP_FROM=noreply@example.com
MAILGUN_DOMAIN=mg.example.com
MAILGUN_API_KEY=your_mailgun_api_key

# -----------------------------------------------------------------------------
# Image tags — pin to known-good versions; Renovate will update these
# -----------------------------------------------------------------------------
FUELROD_TAG=beta
AKILIMO_TAG=latest
COMPUTE_VERSION=latest
MINIO_TAG=RELEASE.2024-03-26T22-10-45Z
