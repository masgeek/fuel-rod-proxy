# =============================================================================
# FUELROD STACK — Laravel application environment
# Copy to .env-fuelrod and fill in values before starting the Fuelrod stack.
# Loaded alongside .env; values here override .env for the same key.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# Generate APP_KEY with: php artisan key:generate --show
# -----------------------------------------------------------------------------
APP_NAME=Munywele
APP_ENV=production
APP_KEY=base64:generate_with_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://your-domain.example.com

# -----------------------------------------------------------------------------
# Logging
# LOG_CHANNELS: comma-separated list e.g. loki,stderr or just stderr
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_CHANNELS=loki,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Loki log shipping (leave empty to disable)
LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# -----------------------------------------------------------------------------
# Database (overrides .env values for Fuelrod services)
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_DATABASE=fuelrod
DB_USERNAME=fuelrod
DB_PASSWORD=change_me
DB_SCHEMA=fuelrod

# -----------------------------------------------------------------------------
# Cache / Queue (Redis)
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=cache
REDIS_PORT=6379
REDIS_QUEUE=fuelrod
# REDIS_PASSWORD=  # set if Redis auth is enabled in .env

BROKER_HOST=${REDIS_HOST}
BROKER_PORT=${REDIS_PORT}
BROKER_PASS=${REDIS_PASSWORD}

# -----------------------------------------------------------------------------
# Mail (uses Mailcatcher in dev, real SMTP in production)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=5025
# Production SMTP example:
# MAIL_HOST=smtp-relay.gmail.com
# MAIL_FROM_ADDRESS=noreply@example.com
# MAIL_USERNAME=your@email.com
# MAIL_PASSWORD=your_smtp_password

# -----------------------------------------------------------------------------
# Zoho CRM integration (leave blank to disable)
# -----------------------------------------------------------------------------
ZOHO_REDIRECT_URL=https://your-domain.example.com/zoho/callback
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_WEBHOOK_SECRET=change_me

# -----------------------------------------------------------------------------
# Image tags
# -----------------------------------------------------------------------------
FUELROD_TAG=beta

# -----------------------------------------------------------------------------
# Third-party integrations (leave blank to disable)
# -----------------------------------------------------------------------------
# SonarQube SAST scanning
SONAR_TOKEN=your_sonarqube_token

# NVD API key for dependency vulnerability scanning (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=your_nvd_api_key
