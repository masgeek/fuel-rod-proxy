// Environment variables with defaults
variable "LOKI_URL" {
  default = "http://loki:3100"
}

variable "JOB_NAME" {
  default = "fuelrod"
}

variable "INSTANCE" {
  default = "grafana-agent"
}

variable "HOST" {
  default = "unknown"
}

// Log collection for supervisor logs
discovery.local.file "supervisor_logs" {
  path_targets = [{
    __path__     = "/var/log/supervisor/*.log",
    job          = JOB_NAME,
    instance     = INSTANCE,
    host         = HOST,
    app          = "fuelrod",
    component    = "supervisor",
  }]
}

// Process and send supervisor logs to Loki
loki.source.file "supervisor" {
  targets    = discovery.local.file.supervisor_logs.targets
  forward_to = [loki.write.default.receiver]
  
  // Optional: exclude compressed logs
  exclude_paths = ["*.log.gz", "*.log.zip"]
}

// Send logs to Loki
loki.write "default" {
  endpoint {
    url = LOKI_URL + "/loki/api/v1/push"
    
    // Performance tuning
    batch_wait  = "1s"
    batch_size  = 1048576  // 1MB
    min_backoff = "100ms"
    max_backoff = "10s"
    max_retries = 3
  }
  
  external_labels = {
    source = "grafana-agent",
  }
}

// Optional: Send agent metrics to Prometheus
prometheus.scrape "agent_metrics" {
  targets = [{
    __address__ = "localhost:12345",
    job         = "grafana-agent",
  }]
  
  forward_to = [prometheus.remote_write.metrics.receiver]
}

prometheus.remote_write "metrics" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}